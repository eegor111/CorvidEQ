{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CorvidEQ",
  "version": "../package.json",
  "identifier": "com.igormitrovic.corvideq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CorvidEQ",
        "width": 1400,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGQTAyRDJBNDJBMTczMDAKUldRQWM2RkNLaTJnRDFPT3d3Vkk5VStzWWVoelY4MDZPL3U5REpZeDlIU2laRWYrOXBPeWtrS3EK",
      "endpoints": [
        "https://github.com/eegor111/CorvidEQ/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
